/* 全局基础重置 */
QWidget {
    background-color: #1E1E1E;
    color: #DCDCDC;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* 输入框 */
QLineEdit {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #3F3F46;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #0E639C;
}

QLineEdit:focus {
    border: 1px solid #007ACC;
    background-color: #333333;
}

/* 按钮基础与交互 */
QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1177BB;
}

QPushButton:pressed {
    background-color: #094771;
}

QPushButton:disabled {
    background-color: #3E3E42;
    color: #858585;
}

QDialog {
    background-color: #252526;
}

QCheckBox {
    color: #CCCCCC;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3F3F46;
    border-radius: 3px;
    background-color: #2D2D2D;
}

QCheckBox::indicator:checked {
    background-color: #0E639C;
    border-color: #007ACC;
}

/* 统一输入框在 Dialog 下的视觉 */
QDialog QLineEdit {
    font-size: 13px;
    height: 24px;
}

/* 强调型大按钮 */
QPushButton#btnLogin {
    font-size: 14px;
    height: 28px;
}

/* 主工作区背景色 */
QMainWindow {
    background-color: #1E1E1E;
}

/* 左侧导航栏容器 */
QWidget#sidebarWidget {
    background-color: #252526;
    border-right: 1px solid #333333;
}

/* 右侧内容容器 */
QWidget#contentWidget {
    background-color: #1E1E1E;
}

/* 底部状态栏 */
QStatusBar {
    background-color: #007ACC; /* 经典工业工控蓝底 */
    color: #FFFFFF;
    font-size: 12px;
    min-height: 28px;
    max-height: 28px;
}

QStatusBar::item {
    border: none;
}

/* -----------------------------------------------------------
   Day 4 追加：侧边栏导航按钮交互规范
   ----------------------------------------------------------- */

/* 侧边栏按钮基础排版 */
QWidget#sidebarWidget QPushButton {
    background-color: transparent;
    color: #CCCCCC;
    border: none;
    border-radius: 0px;
    text-align: left;
    padding-left: 20px;
    font-size: 14px;
    font-weight: 500;
    min-height: 46px;
    max-height: 46px;
}

/* 鼠标悬停 */
QWidget#sidebarWidget QPushButton:hover {
    background-color: #2D2D30;
    color: #FFFFFF;
}

/* 常驻激活/选中状态（工业蓝背景 + 左侧发光指示条） */
QWidget#sidebarWidget QPushButton:checked {
    background-color: #0E639C;
    color: #FFFFFF;
    font-weight: bold;
    border-left: 4px solid #007ACC; /* 4px 亮蓝指示发光边条 */
}

/* 点击下压质感 */
QWidget#sidebarWidget QPushButton:pressed {
    background-color: #094771;
}

/* 状态栏底座 */
QStatusBar {
    background-color: #0E639C; /* 工业深蓝底色 */
    color: #FFFFFF;
    min-height: 28px;
    max-height: 28px;
    border-top: 1px solid #1177BB;
}

/* 四态圆形呼吸发光指示灯 (利用圆角与边框发光) */
QLabel#linkLed {
    border-radius: 5px; /* 10px 宽度的一半即为正圆 */
}

/* 1. 正常在线 (荧光绿) */
QLabel#linkLed[status="normal"] {
    background-color: #00E676;
    border: 1px solid #B9F6CA;
}

/* 2. 预警延迟 (高亮黄) */
QLabel#linkLed[status="warning"] {
    background-color: #FFD600;
    border: 1px solid #FFFF8D;
}

/* 3. 故障断链 (绯红) */
QLabel#linkLed[status="fault"] {
    background-color: #FF1744;
    border: 1px solid #FF8A80;
}

/* 4. 离线休眠 (中性灰) */
QLabel#linkLed[status="offline"] {
    background-color: #757575;
    border: 1px solid #BDBDBD;
}