/* 全局基础重置 */
QWidget {
    background-color: #1E1E1E;
    color: #DCDCDC;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* 输入框 */
QLineEdit {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #3F3F46;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #0E639C;
}

QLineEdit:focus {
    border: 1px solid #007ACC;
    background-color: #333333;
}

/* 按钮基础与交互 */
QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1177BB;
}

QPushButton:pressed {
    background-color: #094771;
}

QPushButton:disabled {
    background-color: #3E3E42;
    color: #858585;
}

QDialog {
    background-color: #252526;
}

QCheckBox {
    color: #CCCCCC;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3F3F46;
    border-radius: 3px;
    background-color: #2D2D2D;
}

QCheckBox::indicator:checked {
    background-color: #0E639C;
    border-color: #007ACC;
}

/* 统一输入框在 Dialog 下的视觉 */
QDialog QLineEdit {
    font-size: 13px;
    height: 24px;
}

/* 强调型大按钮 */
QPushButton#btnLogin {
    font-size: 14px;
    height: 28px;
}